# Copy to .env and fill in. Never commit .env.
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
WEBHOOK_URL=

# Optional overrides (defaults shown)
# PROMPT_VERSION=v3          # v1 = assignment prompt verbatim (baseline), v2 = rewritten prompt, v3 = v2 + code guardrails
# CUSTOMER_ID=MB-CC-10042    # see bot/mock_data.py for the five test accounts
# LLM_MODEL=claude-haiku-4-5
# JUDGE_MODEL=gpt-5-mini
# STT_LANGUAGE=hi-IN
# STT_MODE=translit          # translit = Roman script Hinglish; codemix = Hindi in Devanagari + English
# TTS_MODEL=bulbul:v4-flash
# TTS_VOICE=simran_en_customer
# USE_SILERO_VAD=0           # set 1 to use local Silero VAD instead of Sarvam's server-side VAD
# ALLOW_BARGE_IN=0           # 1 lets the customer cut the bot off mid-sentence; 0 is robust to noisy rooms
# NOISE_SUPPRESSION=1        # RNNoise on the microphone input
# STT_VAD_THRESHOLD=0.75     # higher = needs more confident speech to start a turn
# STT_MIN_SPEECH_MS=350      # ignore bursts shorter than this
# STT_SILENCE_MS=700         # silence that ends the customer's turn
# TURN_MIN_WORDS=3           # words needed before a customer turn starts

# Vendor fallback: sarvam (default) or deepgram (used when Sarvam returns HTTP 429)
VOICE_PROVIDER=sarvam
DEEPGRAM_VOICE=aura-2-thalia-en
