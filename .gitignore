# secrets & local env
.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# runtime state & logs (regenerated by the bot / console)
logs/*.log
logs/calls/*.json
logs/crm_inbox.jsonl
logs/next_call.json
logs/work_queue.json

# eval runs: only the final submission run is committed
eval/results/*
!eval/results/20261119-final/
!eval/results/20261119-final/**

# recordings: compressed .mp4 copies are committed, originals are not
recordings/*.mov
recordings/*.wav
recordings/*.webm

# scratch
_archive/
*.tgz
submission/
*.zip
!eval/results/20261118-sidebyside/
!eval/results/20261118-sidebyside/**
